generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  username      String?         @unique
  emailVerified DateTime?       @map("email_verified")
  image         String?
  password      String?
  vibe          String?
  vibeUpdatedAt DateTime?       @map("vibe_updated_at")
  accounts      Account[]
  sessions      Session[]
  watchlist     WatchlistItem[]
  groupMembers  GroupMember[]
  crimes        Crime[]

  @@map("users")
}

model Group {
  id         String          @id @default(cuid())
  name       String
  inviteCode String          @unique @map("invite_code")
  members    GroupMember[]
  watchlist  WatchlistItem[]
  crimes     Crime[]
  createdAt  DateTime        @default(now()) @map("created_at")

  @@map("groups")
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String   @map("group_id")
  userId   String   @map("user_id")
  role     String   @default("member") // owner | member
  joinedAt DateTime @default(now()) @map("joined_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

enum WatchStatus {
  WATCHING
  COMPLETED
  ON_HOLD
  DROPPED
  PLAN_TO_WATCH
}

model WatchlistItem {
  id             String      @id @default(cuid())
  userId         String?     @map("user_id")
  groupId        String?     @map("group_id")
  tmdbId         Int         @map("tmdb_id")
  mediaType      String      @map("media_type") // movie | tv
  title          String
  posterPath     String?     @map("poster_path")
  backdropPath   String?     @map("backdrop_path")
  status         WatchStatus @default(PLAN_TO_WATCH)
  rating         Int?
  notes          String?
  currentSeason  Int?        @map("current_season")
  currentEpisode Int?        @map("current_episode")
  currentMinute  Int?        @map("current_minute")
  genres         String[]    @default([])
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, tmdbId])
  @@unique([groupId, tmdbId])
  @@map("watchlist_items")
}

model Crime {
  id        String   @id @default(cuid())
  groupId   String   @map("group_id")
  userId    String   @map("user_id")
  tmdbId    Int      @map("tmdb_id")
  title     String
  season    Int
  episode   Int
  penance   String
  createdAt DateTime @default(now()) @map("created_at")

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("crimes")
}
